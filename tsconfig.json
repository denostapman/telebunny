{
	"include": ["src"],
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "lib",
		"module": "nodenext",
		"target": "es2023",
		"strict": true,
		"declaration": true,
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"noEmitOnError": true,
		"skipLibCheck": true,
		"types": ["node"]
	}
}
