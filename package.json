{
	"name": "telebunny",
	"version": "3.2.0",
	"description": "Lightweight zero-dependency module for Telegram Bot API on Node.js, Bun and Deno",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"type": "module",
	"scripts": {
		"clean": "node -e \"fs.rmSync('lib', { recursive: true, force: true })\"",
		"build": "node --run clean && tsc",
		"test": "npm run test:node && npm run test:bun && npm run test:deno",
		"test:node": "node --test test/*.test.ts",
		"test:bun": "for file in test/*.test.ts; do bun test \"./$file\" || exit 1; done",
		"test:deno": "deno test --allow-all --no-check test/",
		"prepack": "npm run build",
		"prepublishOnly": "npm test",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"keywords": [
		"telegram",
		"telegram bot",
		"telegram bot api",
		"telegram bunny",
		"bunny",
		"bot",
		"api",
		"typescript"
	],
	"files": [
		"lib"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/denostapman/telebunny.git"
	},
	"author": "Funny Bunny",
	"license": "MIT",
	"engines": {
		"node": ">=22.0.0",
		"bun": ">=1.2.11",
		"deno": ">=2.8.0"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"prettier": "3.9.10",
		"typescript": "7.0.2"
	}
}
