{
	"$schema": "https://json.schemastore.org/prettierrc",
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 80,
	"semi": true,
	"singleQuote": true,
	"trailingComma": "all",
	"endOfLine": "lf",
	"overrides": [
		{
			"files": "*.md",
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}
